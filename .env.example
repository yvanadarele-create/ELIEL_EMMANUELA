# ELIEL EMMANUELA — variables d'environnement
#
# Copiez ce fichier en .env et remplissez-le. .env est ignoré par git et ne doit
# JAMAIS être commité. Ce fichier-ci ne contient que des noms de variables et
# aucune valeur réelle.
#
# Ce qui n'est pas secret — numéros WhatsApp, réseaux sociaux, opérateurs de
# paiement acceptés — vit dans config/brand.json, qui est public et commité.
# Les variables ci-dessous l'emportent sur ce fichier quand elles sont définies,
# ce qui permet à un déploiement de préproduction d'utiliser d'autres valeurs.

# --- Site ---------------------------------------------------------------------
# Domaine de production. Réécrit canonicals, Open Graph, JSON-LD et sitemap.
SITE_URL=

# --- Contact et vente ---------------------------------------------------------
# Chiffres uniquement pour wa.me ; les espaces sont acceptés et nettoyés.
# 1 = commandes. 2 = service client et suivi de livraison.
WHATSAPP_NUMBER_1=
WHATSAPP_NUMBER_2=
ELIEL_INSTAGRAM=
ELIEL_TIKTOK=
ELIEL_FACEBOOK=
ELIEL_EMAIL=

# --- Base de données ----------------------------------------------------------
# Postgres. Neon, Supabase ou Vercel Postgres — n'importe lequel convient.
DATABASE_URL=

# --- Authentification de l'administration ------------------------------------
# Secret de signature des sessions. Générer avec : openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Agent IA -----------------------------------------------------------------
AI_API_KEY=
AI_MODEL=

# --- Paiement -----------------------------------------------------------------
# À remplir selon l'agrégateur retenu pour Wave / Orange Money / Moov / MoMo.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Livraison ----------------------------------------------------------------
# Le code parle à une abstraction ShippingProvider ; ces clés sont celles du
# transporteur réellement branché.
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
SHIPPING_ACCOUNT_ID=
